# ==============================================================================
# QueZap — Production Deployment Configuration (Docker Compose + GraalVM Native)
# ==============================================================================
# Copy this file to `.env` and replace ALL `CHANGE_ME_*` placeholders before
# running `docker compose pull && docker compose up -d`.
#
# Generate strong secrets:
#   openssl rand -hex 32     # APP_JWT_SECRET_KEY
#   openssl rand -base64 24  # POSTGRES_PASSWORD & RUSTFS_SECRET_KEY
# ==============================================================================

# --- Release & Public URL ---
# Pre-built GHCR image tag (e.g., latest, v1.0.0)
QUEZAP_VERSION=latest
# Host HTTP port exposed by Nginx (place behind an HTTPS reverse proxy)
APP_PORT=8000
# Full public URL seen by browsers (no trailing slash, e.g., https://quezap.fr)
APP_PUBLIC_URL=http://localhost:8000

# --- Frontend Runtime Configuration (injected at container startup via /config.json) ---
APP_NAME=QueZap
APP_AUTHOR_NAME=Author User
APP_AUTHOR_EMAIL=author@example.net
APP_API_URL=/apiv1

# --- PostgreSQL 17 ---
POSTGRES_DB=quezap
POSTGRES_USER=quezap
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- RustFS (S3-Compatible Object Storage) ---
RUSTFS_ACCESS_KEY=quezap_s3_writer
RUSTFS_SECRET_KEY=CHANGE_ME_STRONG_RUSTFS_SECRET
# Enable the RustFS web console only for debugging (false recommended in production)
RUSTFS_CONSOLE_ENABLE=false
# Public bucket name (must match the /quezap-public-images/ route in front/nginx.conf)
APP_S3_BUCKET_NAME=quezap-public-images

# --- JWT Security ---
# Hex secret key >= 32 bytes (64 hex chars): `openssl rand -hex 32`
APP_JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
APP_JWT_ISSUER=quezap.fr

# --- Hibernate / Database Schema ---
# Use `update` on initial deployment or schema upgrades; switch to `validate` if desired.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
