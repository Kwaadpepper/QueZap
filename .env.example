# ==============================================================================
# QueZap - Configuration de déploiement Production (Docker Compose + GraalVM Native)
# ==============================================================================
# Copier ce fichier vers `.env` et remplacer TOUTES les valeurs CHANGE_ME avant
# de lancer `docker compose up -d --build`.
#
# Générer des secrets robustes :
#   openssl rand -hex 32   (pour APP_JWT_SECRET_KEY)
#   openssl rand -base64 24 (pour les mots de passe)
# ==============================================================================

# --- Exposition & URL publique ---
# Port HTTP exposé sur l'hôte (à placer derrière votre reverse proxy HTTPS sur le NUC/Proxmox)
APP_PORT=8000
# URL publique complète vue par les navigateurs (sans slash final, ex: https://quezap.fr)
APP_PUBLIC_URL=http://localhost:8000

# --- PostgreSQL 17 ---
POSTGRES_DB=quezap
POSTGRES_USER=quezap
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- RustFS (Stockage S3 compatible) ---
RUSTFS_ACCESS_KEY=quezap_s3_writer
RUSTFS_SECRET_KEY=CHANGE_ME_STRONG_RUSTFS_SECRET
# Activer la console web RustFS uniquement si besoin de debug (false recommandé en prod)
RUSTFS_CONSOLE_ENABLE=false
# Nom du bucket public (doit correspondre à la route /quezap-public-images/ dans front/nginx.conf)
APP_S3_BUCKET_NAME=quezap-public-images

# --- Sécurité JWT ---
# Clé hexadécimale >= 32 octets (64 caractères hex) : `openssl rand -hex 32`
APP_JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
APP_JWT_ISSUER=quezap.fr

# --- Hibernate / Schéma BDD ---
# Utiliser `update` lors du premier déploiement ou d'une montée de version,
# puis `validate` en production stabilisée si souhaité.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
